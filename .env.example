# API auth runtime
# - local API default: auth-handler
# - deployed API default: lambda-authorizer
AUTH_PROVIDER=auth-handler

# Legacy upstream-provider verifier settings
# Keep these for direct provider adapters and upstream federation helpers.
AUTH_SECRET_KEY=
AUTH_PUBLISHABLE_KEY=

# Platform token issuer / verifier settings
AUTH_HANDLER_ISSUER=http://localhost:3002/auth
AUTH_HANDLER_AUDIENCE=forge-core-api
AUTH_HANDLER_PRIVATE_KEY=
AUTH_HANDLER_PUBLIC_KEY=
AUTH_HANDLER_COOKIE_SECRET=forge-core-auth-handler-cookie-secret
AUTH_HANDLER_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_HANDLER_ID_TOKEN_TTL_SECONDS=900
AUTH_HANDLER_REFRESH_TOKEN_TTL_SECONDS=2592000

# Static downstream OAuth/OIDC client registry (JSON array)
# Leave blank to use the built-in local defaults, including forge-postman.
AUTH_HANDLER_CLIENTS_JSON=

# Append redirect URIs to existing clients without replacing the whole registry.
# JSON array of { clientId, redirectUri } pairs. Use this in Vercel/staging to
# add deployment-specific callback URLs without code changes. Example:
# [{"clientId":"agent-forge-web","redirectUri":"https://myapp.vercel.app/callback"}]
AUTH_HANDLER_EXTRA_REDIRECT_URIS=

# Upstream identity connections for auth-handler (JSON array)
# Leave blank to use the built-in local `dev` connection plus the optional
# Clerk connection below when its discovery URL and client ID are set.
AUTH_HANDLER_CONNECTIONS_JSON=

# Optional default Clerk upstream OIDC connection for auth-handler.
# Register auth-handler as an OAuth/OIDC app in Clerk and set:
# - redirect URIs:
#   - http://localhost:3002/auth/callback/clerk
#   - https://api.dev.mindrithm.app/auth/callback/clerk
# - Postman callback URIs on the downstream forge-postman client:
#   - https://oauth.pstmn.io/v1/callback
#   - https://oauth.pstmn.io/v1/browser-callback
AUTH_HANDLER_CLERK_CONNECTION_ID=clerk
AUTH_HANDLER_CLERK_CONNECTION_NAME=Clerk
AUTH_HANDLER_CLERK_DISCOVERY_URL=
AUTH_HANDLER_CLERK_CLIENT_ID=
AUTH_HANDLER_CLERK_CLIENT_SECRET=
AUTH_HANDLER_CLERK_SCOPES=openid profile email

# Comma-separated list of allowed org IDs (defense-in-depth)
ALLOWED_ORG_IDS=

# Dashboard/admin CORS origins for the API and auth-handler.
# Website widget client domains are configured per Website channel in the UI.
CORS_ORIGIN=http://localhost:3000,http://localhost:3003

# Database (local dev — direct Postgres connection)
# Lambda uses DB_PROXY_ENDPOINT + DB_USERNAME + DB_NAME + DB_AUTH_MODE=iam (injected by Terraform)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/forge_agents

# Database (AWS Lambda — injected by Terraform)
# DB_AUTH_MODE=iam
# DB_PROXY_ENDPOINT=
# DB_USERNAME=app
# DB_NAME=forge_agents

# Anthropic API key (for forge-core-ai LLM calls)
ANTHROPIC_API_KEY=
