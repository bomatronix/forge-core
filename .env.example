# Auth provider: 'clerk' (default) | 'next-auth' | 'okta'
AUTH_PROVIDER=clerk

# Provider-specific secret key for token verification
AUTH_SECRET_KEY=

# Publishable key — required for Clerk testing token verification locally (pk_test_...)
AUTH_PUBLISHABLE_KEY=

# Comma-separated list of allowed Clerk/Okta org IDs (defense-in-depth)
ALLOWED_ORG_IDS=

# CORS origin for the API
CORS_ORIGIN=http://localhost:3000
