{
  "name": "forge-core",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "scripts": {
    "dev": "nest start api --watch",
    "dev:debug": "nest start api --debug --watch",
    "clean": "rm -rf dist && find apps libs -type f \\( -name '*.js' -o -name '*.d.ts' -o -name '*.js.map' \\) ! -name 'jest.config.js' -delete",
    "prebuild": "pnpm clean",
    "build": "nest build api",
    "build:app": "nest build $APP && node esbuild.config.mjs $APP",
    "build:lambda": "APP=api pnpm build:app",
    "build:authorizer": "APP=authorizer pnpm build:app",
    "build:all": "APP=api pnpm build:app && APP=authorizer pnpm build:app",
    "analyze": "nest build $APP && node esbuild.config.mjs $APP --analyze",
    "build:client": "nest build $CLIENT && node esbuild.config.mjs $CLIENT",
    "start": "node dist/apps/api/src/main.js",
    "start:prod": "NODE_ENV=production node dist/apps/api/src/main.js",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1028.0",
    "@clerk/backend": "^3.2.4",
    "@codegenie/serverless-express": "^4.15.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/aws-lambda": "^8.10.145",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.2.5",
    "turbo": "^2.3.0",
    "typescript": "5.7.3"
  }
}
