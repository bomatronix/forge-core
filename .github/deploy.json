{
  "workspaces": {
    "forge-core": {
      "apps": ["api", "authorizer", "auth-handler"],
      "artifacts": {
        "api": ["crud", "presign"],
        "authorizer": ["authorizer"],
        "auth-handler": ["auth-handler"]
      },
      "client_artifacts": {
        "mindrithm": {
          "api": ["forge-core-api"],
          "authorizer": ["authorizer"],
          "auth-handler": ["auth-handler"]
        }
      },
      "lambda_key_prefix": "api",
      "dev": {
        "tfe_workspace": "${CLIENT}-dev-api",
        "s3_bucket": "${S3_FORGE_CORE}"
      },
      "qa": {
        "tfe_workspace": "${CLIENT}-qa-api",
        "s3_bucket": "${S3_FORGE_CORE}"
      },
      "staging": {
        "tfe_workspace": "${CLIENT}-staging-api",
        "s3_bucket": "${S3_FORGE_CORE}"
      },
      "prod": {
        "tfe_workspace": "${CLIENT}-prod-api",
        "s3_bucket": "${S3_FORGE_CORE}"
      }
    }
  }
}
