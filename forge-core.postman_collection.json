{
  "info": {
    "name": "Forge Core API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.dev.mindrithm.app",
      "type": "string",
      "description": "Switch to http://localhost:3001 for local dev"
    },
    {
      "key": "authSecretKey",
      "value": "sk_test_REPLACE_ME",
      "type": "string",
      "description": "Clerk sk_test_ key — only needed for dev testing tokens"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Paste a real user JWT here, or run one of the Get Token requests"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Token — Real User (from browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "about:blank",
              "raw": "about:blank"
            },
            "description": "**How to get a real user JWT from Clerk:**\n\n1. Open the frontend app in your browser and log in\n2. Open DevTools → Console\n3. Run:\n```js\nawait window.Clerk.session.getToken()\n```\n4. Copy the returned JWT\n5. Paste it into the `accessToken` collection variable\n\nThis is the same token the frontend sends as `Authorization: Bearer <token>` to the API."
          }
        },
        {
          "name": "Get Token — Dev Testing (Clerk direct)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Token returned', () => pm.expect(json.token).to.be.a('string'));",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('accessToken', json.token);",
                  "  const exp = new Date(json.expires_at * 1000).toISOString();",
                  "  console.log('accessToken saved, expires at', exp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authSecretKey}}"
              }
            ],
            "url": {
              "raw": "https://api.clerk.com/v1/testing_tokens",
              "protocol": "https",
              "host": ["api", "clerk", "com"],
              "path": ["v1", "testing_tokens"]
            },
            "description": "Dev/CI only — gets a Clerk testing JWT without a browser login.\n\nRequires `authSecretKey` = `sk_test_...`. Testing tokens are short-lived and represent a generic test user, not a real account."
          }
        },
        {
          "name": "Inspect Token (verify claims)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify"]
            },
            "description": "Passes the token through the same verification the Lambda Authorizer uses and returns the injected context (userId, email, name, avatarUrl, orgId).\n\nUseful for confirming the token is valid and seeing what claims will be available in the Lambda."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health (public — no auth)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "Health (through authorizer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Same endpoint but with Bearer token — hits the Lambda Authorizer first.\n\n- 200 = authorizer accepted the token ✅\n- 401/403 = authorizer rejected it ❌"
          }
        }
      ]
    }
  ]
}
