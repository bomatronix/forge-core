{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "builder": "tsc",
    "tsConfigPath": "apps/api/tsconfig.app.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "sourceRoot": "apps/api/src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "sourceRoot": "libs/common/src",
      "entryFile": "index",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "core": {
      "type": "library",
      "root": "libs/core",
      "sourceRoot": "libs/core/src",
      "entryFile": "index",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "authorizer": {
      "type": "application",
      "root": "apps/authorizer",
      "sourceRoot": "apps/authorizer/src",
      "entryFile": "handler",
      "compilerOptions": {
        "tsConfigPath": "apps/authorizer/tsconfig.app.json"
      }
    },
    "auth-handler": {
      "type": "application",
      "root": "apps/auth-handler",
      "sourceRoot": "apps/auth-handler/src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-handler/tsconfig.app.json"
      }
    }
  }
}
